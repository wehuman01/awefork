{
  "name": "awefork",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Non-linear session workbench for AI coding agents — fork any turn, keep every branch",
  "license": "MPL-2.0",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "vite --config vite.demo.config.ts",
    "build": "electron-vite build",
    "dist": "node scripts/archive-dist.mjs && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "node scripts/archive-dist.mjs && electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.wehuman01.awefork",
    "productName": "awefork",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!node_modules/**"
    ],
    "electronLanguages": [
      "en",
      "zh-CN"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "mammoth": "^1.12.2",
    "word-extractor": "^1.0.4"
  }
}
